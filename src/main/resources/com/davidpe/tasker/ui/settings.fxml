<?xml version="1.0" encoding="UTF-8"?>

<?import com.davidpe.tasker.application.ui.controls.ToolbarIconButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="760.0" prefWidth="1180.0" styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.davidpe.tasker.application.ui.settings.SettingsSceneController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="workspace-header header-bar">
            <VBox spacing="6.0">
                <Label styleClass="eyebrow-label" text="Application preferences" />
                <Label styleClass="app-title" text="Settings" />
                <Label styleClass="hero-support" text="Choose how Tasker looks while you plan and complete your work." wrapText="true" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                <Button fx:id="applyButton" managed="false" mnemonicParsing="false" onAction="#applySettings" styleClass="primary-button" text="Apply" visible="false" />
                <ToolbarIconButton accessibleText="Back to tasks" darkIconResource="/com/davidpe/tasker/ui/images/chevron_left_18dp_white.png" lightIconResource="/com/davidpe/tasker/ui/images/chevron_left_18dp_white.png" onAction="#backToMain" tooltipText="Back to tasks" />
            </HBox>
        </HBox>
    </top>
    <center>
        <StackPane alignment="TOP_CENTER" styleClass="settings-content">
            <padding><Insets bottom="64.0" left="80.0" right="80.0" top="56.0" /></padding>
            <VBox maxWidth="680.0" spacing="16.0" styleClass="settings-card">
                <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
                <Label styleClass="eyebrow-label" text="Appearance" />
                <Label styleClass="card-title" text="Night mode" />
                <Label styleClass="card-copy" text="Use the dark Tasker workspace across every screen. The preference is stored locally for your next session." wrapText="true" />
                <CheckBox fx:id="nightModeCheckBox" mnemonicParsing="false" styleClass="settings-check-box" text="Enable night mode" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
