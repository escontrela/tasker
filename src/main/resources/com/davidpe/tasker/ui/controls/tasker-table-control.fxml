<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<fx:root fx:id="paneTableTask" prefHeight="533.0" prefWidth="1144.0" styleClass="note-panel" stylesheets="@../styles.css" type="Pane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

   <children>
      <Separator fx:id="sepTasker" layoutX="15.0" layoutY="473.0" prefHeight="0.0" prefWidth="1081.0" />
      <Button fx:id="btLeft" alignment="BASELINE_CENTER" layoutX="1007.0" layoutY="483.0" mnemonicParsing="false" onAction="#buttonAction" prefHeight="33.0" prefWidth="35.0" styleClass="button-regular" stylesheets="@../styles.css" textFill="WHITE">
         <font>
            <Font name="Alatsi Regular" size="18.0" />
         </font>
         <graphic>
            <ImageView fx:id="imgMoveLeft" fitHeight="16.0" fitWidth="25.0" onMouseClicked="#onMouseClicked" preserveRatio="true">
               <image>
                  <Image url="@../images/chevron_left_18dp_white.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
      <Button fx:id="btColumn" alignment="BASELINE_CENTER" layoutX="963.0" layoutY="483.0" mnemonicParsing="false" onAction="#buttonAction" prefHeight="33.0" prefWidth="35.0" styleClass="button-regular" stylesheets="@../styles.css" textFill="WHITE">
         <font>
            <Font name="Alatsi Regular" size="18.0" />
         </font>
         <graphic>
            <ImageView fx:id="imgColumn" fitHeight="16.0" fitWidth="25.0" onMouseClicked="#onMouseClicked" preserveRatio="true">
               <image>
                  <Image url="@../images/chevron_left_18dp_white.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
      <Button fx:id="btRight" alignment="BASELINE_CENTER" layoutX="1051.0" layoutY="483.0" mnemonicParsing="false" onAction="#buttonAction" prefHeight="33.0" prefWidth="35.0" styleClass="button-regular" stylesheets="@../styles.css" textFill="WHITE">
         <font>
            <Font name="Alatsi Regular" size="18.0" />
         </font>
         <graphic>
            <ImageView fx:id="imgMoveRight" fitHeight="16.0" fitWidth="25.0" onMouseClicked="#onMouseClicked" preserveRatio="true">
               <image>
                  <Image url="@../images/chevron_right_18dp_white.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
   </children>
</fx:root>
