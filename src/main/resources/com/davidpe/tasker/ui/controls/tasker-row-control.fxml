<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<fx:root fx:id="paneRow" prefHeight="88.0" prefWidth="548.0" styleClass="score-strip" stylesheets="@../styles.css" type="Pane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

   <children>
      <Label fx:id="lblName" layoutX="108.0" layoutY="17.0" prefHeight="22.0" prefWidth="294.0" text="Implement the new UI row style" textFill="WHITE">
         <font>
            <Font size="17.0" />
         </font></Label>
      <Label fx:id="lblTags1" layoutX="108.0" layoutY="65.0" prefHeight="17.0" prefWidth="52.0" text="general" textAlignment="CENTER" textFill="#b231b0" />
      <Label fx:id="lblTags2" layoutX="169.0" layoutY="65.0" prefHeight="17.0" prefWidth="81.0" text="integrations" textAlignment="CENTER" textFill="#225aae" />
      <Label fx:id="lblOpen" layoutX="447.0" layoutY="58.0" onMouseClicked="#onMouseClicked" prefHeight="17.0" prefWidth="52.0" text="Open" textAlignment="CENTER" textFill="#dee012" />
      <ImageView fx:id="imgDelete" fitHeight="16.0" fitWidth="25.0" layoutX="518.0" layoutY="15.0" onMouseClicked="#onMouseClicked" preserveRatio="true">
         <image>
            <Image url="@../images/delete_18dp_white.png" />
         </image>
      </ImageView>
      <ImageView fx:id="imgEdit" fitHeight="16.0" fitWidth="25.0" layoutX="518.0" layoutY="32.0" onMouseClicked="#onMouseClicked" preserveRatio="true">
         <image>
            <Image url="@../images/edit_square_18dp_white.png" />
         </image>
      </ImageView>
      <ImageView fx:id="imgUp" fitHeight="16.0" fitWidth="25.0" layoutX="518.0" layoutY="50.0" onMouseClicked="#onMouseClicked" preserveRatio="true">
         <image>
            <Image url="@../images/text_select_move_up_18dp_white.png" />
         </image>
      </ImageView>
      <ImageView fx:id="imgDown" fitHeight="16.0" fitWidth="25.0" layoutX="518.0" layoutY="64.0" onMouseClicked="#onMouseClicked" preserveRatio="true">
         <image>
            <Image url="@../images/text_select_move_down_18dp_white.png" />
         </image>
      </ImageView>
      <Pane fx:id="paneDate" layoutX="14.0" layoutY="8.0" prefHeight="71.0" prefWidth="71.0" styleClass="date-square-panel" stylesheets="@../../../../../../../../../chess-journey/src/main/resources/com/davidp/chessjourney/custom-styles.css">
         <children>
            <Label fx:id="lblMonthAbbrev" alignment="CENTER" layoutX="0.0" layoutY="15.0" prefHeight="16.0" prefWidth="71.0" styleClass="date-month-label" text="Sep" textAlignment="CENTER" textFill="#CCCCCC">
               <font>
                  <Font name="Alatsi Regular" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblDayNumber" alignment="CENTER" layoutY="35.0" prefHeight="28.0" prefWidth="71.0" styleClass="date-day-label" text="15" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font name="Alatsi Regular" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>
      <Button fx:id="btDone" alignment="BASELINE_CENTER" layoutX="428.0" layoutY="9.0" mnemonicParsing="false" onAction="#buttonAction" prefHeight="37.0" prefWidth="71.0" styleClass="button-regular" stylesheets="@../styles.css" textFill="WHITE">
         <font>
            <Font name="Alatsi Regular" size="18.0" />
         </font>
         <graphic>
            <Label fx:id="lbDonebutton" alignment="CENTER" prefHeight="18.0" prefWidth="45.0" text="done" textAlignment="CENTER" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </graphic>
      </Button>
   </children>
</fx:root>
